<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolV001</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">نظام إدارة المدرسة</a>
            <div class="navbar-nav">
                <a class="nav-link text-white" asp-controller="Students" asp-action="Index">الطلاب</a>
                <a class="nav-link text-white" asp-controller="Marks" asp-action="Entry">العلامات</a>
                <a class="nav-link text-white" asp-controller="Reports" asp-action="PrimaryClearance" asp-route-studentId="1">الجلاء</a>
            </div>
        </div>
    </nav>
    <main class="container py-4">
        @RenderBody()
    </main>
</body>
</html>
