<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام إدارة مدرسة</title>
    <style>
        body { font-family: Tahoma, sans-serif; margin: 0; background: #f7f7f7; }
        nav { background: #0f4c81; color: #fff; padding: 12px; }
        nav a { color: #fff; margin-left: 10px; text-decoration: none; }
        .container { padding: 20px; }
        .card { background: #fff; border-radius: 8px; padding: 16px; margin-bottom: 12px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; }
        .stats { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px; }
    </style>
</head>
<body>
    <nav>
        <a asp-controller="Dashboard" asp-action="Index">الرئيسية</a>
        <a asp-controller="Students" asp-action="Index">الطلاب</a>
        <a asp-controller="Attendance" asp-action="Index">الغياب</a>
        <a asp-controller="Marks" asp-action="Index">العلامات</a>
        <a asp-controller="Reports" asp-action="Index">الجلاء والتقارير</a>
        <a asp-controller="Settings" asp-action="Index">الإعدادات</a>
    </nav>
    <div class="container">
        @RenderBody()
    </div>
</body>
</html>
