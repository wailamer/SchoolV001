@model DashboardVm
@{ ViewData["Title"] = "لوحة التحكم"; }
<h1>لوحة تحكم النظام المدرسي</h1>
<div class="cards">
    <div class="card"><h3>الطلاب</h3><p>@Model.StudentsCount</p></div>
    <div class="card"><h3>السجلات السنوية</h3><p>@Model.RecordsCount</p></div>
    <div class="card"><h3>المعلمين</h3><p>@Model.TeachersCount</p></div>
    <div class="card"><h3>المواد</h3><p>@Model.SubjectsCount</p></div>
</div>
<h3>التنبيهات</h3>
@foreach (var alert in Model.Alerts)
{
    <div class="alert">@alert</div>
}
