<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام إدارة المدرسة</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="brand">
                <h1>SchoolV001</h1>
                <small>منصة إدارة المدرسة</small>
            </div>
            <nav class="nav flex-column gap-2">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">لوحة التحكم</a>
                <a class="nav-link" asp-controller="Students" asp-action="Index">إدارة الطلاب</a>
                <a class="nav-link" asp-controller="Marks" asp-action="Entry" asp-route-studentRecordId="1">إدخال العلامات</a>
                <a class="nav-link" asp-controller="Attendance" asp-action="Quick">لوحة الدوام</a>
                <a class="nav-link" asp-controller="Settings" asp-action="Index">إعدادات المدرسة</a>
            </nav>
        </aside>

        <div class="app-content">
            <header class="app-header">
                <div>
                    <h2 class="mb-0">@ViewData["Title"]</h2>
                    <small class="text-muted">نظام أكاديمي وإداري متكامل</small>
                </div>
            </header>
            <main class="content-wrapper">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
