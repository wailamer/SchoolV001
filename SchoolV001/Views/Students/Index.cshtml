@model List<StudentRegistration>
@{
    ViewData["Title"] = "إدارة الطلاب";
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-8">
                <input name="search" class="form-control" placeholder="بحث بالاسم أو الرقم العام أو الكود الوزاري" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">بحث</button>
                <a asp-action="Create" class="btn btn-success">إضافة طالب</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>الرقم العام</th>
                    <th>الكود الوزاري</th>
                    <th>الاسم الكامل</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Any())
            {
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.GeneralRegisterNumber</td>
                        <td>@student.MinistryCode</td>
                        <td>@student.FullName</td>
                        <td>
                            <span class="badge bg-@(student.IsActive ? "success" : "secondary")">
                                @(student.IsActive ? "نشط" : "غير نشط")
                            </span>
                        </td>
                        <td>
                            <a asp-controller="Reports" asp-action="Clearance" asp-route-studentId="@student.Id" class="btn btn-sm btn-outline-primary">جلاء</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5" class="text-center p-4">لا يوجد بيانات طلاب حالياً.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
